import "mbuild/api";

// raize_api: JSON APIs on raize: typed requests, problem details, OpenAPI 3.1, pagination
// Library; its one bin is the example_todos example.
fn project() {
  mb_package("raize_api", "0.1.0");
  mb_meta("description", "JSON APIs on raize: typed requests, problem details, OpenAPI 3.1, pagination");
  mb_meta("license", "Apache-2.0");
  mb_meta("repository", "https://github.com/Lex-Dellimere/RaizeAPI");
  mb_import_root("src");
  mb_bin("example_todos", "examples/todos/main.mettle");
}

// raize packages by path until raize is published; publish switches these to mb_dep.
fn deps() {
  mb_dep_path("raize_core", "../raize_web/libs/core");
  mb_dep_path("raize_resource", "../raize_web/libs/resource");
  mb_dep_path("raize_app", "../raize_web/libs/app");
  mb_dep_path("codec", "../codec");
  mb_dep_path("press", "../press");
  mb_dep("json", "v1.0.0");
}

// fuzz: a long fuzzing run in release (`mbuild fuzz 2000000` for more rounds).
fn cmd_fuzz(a: MbArgs*) -> int32 {
  var n: string = "500000";
  if (mb_nargs(a) > 0) { n = mb_arg(a, 0); }
  return mb_sh("RAPI_FUZZ_ITERS=" + n + " \"$MBUILD_EXE\" test fuzz -r --force");
}
